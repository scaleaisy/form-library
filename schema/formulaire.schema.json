{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "specVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "language": {
      "default": "fr",
      "type": "string",
      "enum": [
        "fr",
        "en",
        "es",
        "de"
      ]
    },
    "goal": {
      "default": "beforeCalendar",
      "type": "string",
      "enum": [
        "optin",
        "beforeCalendar",
        "afterCalendar",
        "reactivation"
      ]
    },
    "display": {
      "default": {
        "mode": "classic",
        "size": "medium"
      },
      "type": "object",
      "properties": {
        "mode": {
          "default": "classic",
          "type": "string",
          "enum": [
            "classic",
            "immersive",
            "fullPage"
          ]
        },
        "size": {
          "default": "medium",
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        }
      },
      "additionalProperties": false
    },
    "design": {
      "default": {},
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        },
        "primaryColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "textColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "fieldTextColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "buttonTextColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "transparentBackground": {
          "type": "boolean"
        },
        "darkMode": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "intro": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "subtitle": {
          "type": "string",
          "maxLength": 260
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "contact": {
      "default": {
        "position": "beforeQuestions",
        "phoneRequired": true,
        "lastNameRequired": false,
        "countrySelector": false
      },
      "type": "object",
      "properties": {
        "position": {
          "default": "beforeQuestions",
          "type": "string",
          "enum": [
            "beforeQuestions",
            "afterQuestions"
          ]
        },
        "phoneRequired": {
          "default": true,
          "type": "boolean"
        },
        "lastNameRequired": {
          "default": false,
          "type": "boolean"
        },
        "countrySelector": {
          "default": false,
          "type": "boolean"
        },
        "consent": {
          "type": "object",
          "properties": {
            "required": {
              "default": false,
              "type": "boolean"
            },
            "text": {
              "type": "string",
              "maxLength": 500
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "properties": {
        "offer": {
          "type": "string",
          "maxLength": 1600
        },
        "targetAudience": {
          "type": "string",
          "maxLength": 1600
        },
        "priceOrCommitment": {
          "type": "string",
          "maxLength": 600
        },
        "hardDisqualifiers": {
          "type": "string",
          "maxLength": 1600
        },
        "idealProfile": {
          "type": "string",
          "maxLength": 4000
        },
        "lowInterestProfile": {
          "type": "string",
          "maxLength": 4000
        },
        "disqualifyingProfile": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "additionalProperties": false
    },
    "questions": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "help": {
                "type": "string",
                "maxLength": 1200
              },
              "required": {
                "default": true,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "voice"
              },
              "maxDurationSeconds": {
                "default": 60,
                "type": "integer",
                "minimum": 15,
                "maximum": 180
              },
              "ai": {
                "type": "object",
                "properties": {
                  "idealAnswer": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "lowInterestAnswer": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "disqualifyingAnswer": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "eliminatory": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "text",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "help": {
                "type": "string",
                "maxLength": 1200
              },
              "required": {
                "default": true,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "text"
              },
              "ai": {
                "type": "object",
                "properties": {
                  "idealAnswer": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "lowInterestAnswer": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "disqualifyingAnswer": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "eliminatory": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "text",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "help": {
                "type": "string",
                "maxLength": 1200
              },
              "required": {
                "default": true,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "choice"
              },
              "multiple": {
                "default": false,
                "type": "boolean"
              },
              "options": {
                "minItems": 2,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "impact": {
                      "default": "neutral",
                      "type": "string",
                      "enum": [
                        "veryPositive",
                        "positive",
                        "neutral",
                        "negative",
                        "disqualifying"
                      ]
                    }
                  },
                  "required": [
                    "key",
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "routes": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "defaultNext": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "text",
              "type",
              "options"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "help": {
                "type": "string",
                "maxLength": 1200
              },
              "required": {
                "default": true,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "scale"
              },
              "maximum": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99000000
              },
              "ranges": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "from": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "to": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "impact": {
                      "default": "neutral",
                      "type": "string",
                      "enum": [
                        "veryPositive",
                        "positive",
                        "neutral",
                        "negative",
                        "disqualifying"
                      ]
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "key",
              "text",
              "type",
              "maximum",
              "ranges"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "endings": {
      "default": {},
      "type": "object",
      "properties": {
        "qualified": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 240
            },
            "subtitle": {
              "type": "string",
              "maxLength": 1200
            },
            "button": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "url": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false
            },
            "calendarUrl": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "additionalProperties": false
        },
        "disqualified": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 240
            },
            "subtitle": {
              "type": "string",
              "maxLength": 1200
            },
            "button": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "url": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "specVersion",
    "name",
    "questions"
  ],
  "additionalProperties": false
}
